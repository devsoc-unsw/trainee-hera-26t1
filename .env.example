# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Google Maps — enable Maps JavaScript API + Places API in Google Cloud Console.
# Use a browser key (HTTP referrer restrictions) for the public key:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Server key for geocoding (POST /api/addresses/add-address). Can be the same key with IP restrictions.
GOOGLE_MAPS_API_KEY=your_google_maps_server_key

# URL of the deployed Google Cloud Function for the VRP solver
ROADTRIP_SOLVER_URL=
