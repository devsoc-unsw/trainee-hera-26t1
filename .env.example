# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Optional: only needed for POST /api/addresses/add-address
GOOGLE_MAPS_API_KEY=your_google_maps_server_key
